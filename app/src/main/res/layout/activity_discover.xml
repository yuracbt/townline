<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested feeds"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:id="@+id/suggestSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Checking which local feeds work…"
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/suggestList"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Events &amp; places"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Local event calendars, the library, business events — scanned by you in one tap."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/eventsList"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add event page"
            android:backgroundTint="@color/teal"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Saved links"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Links you saved via Share → TownLine from any app."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/savedList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
