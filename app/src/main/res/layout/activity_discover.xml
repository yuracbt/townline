<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Facebook groups"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Meta doesn't allow apps to scan group discussions automatically. Add your groups here for one-tap access instead."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/fbList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddFb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add Facebook group"
            android:backgroundTint="@color/teal"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Saved posts"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Posts you shared from Facebook via Share → TownLine."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/fbPostsList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Events &amp; places"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Local event calendars, the library, business events — scanned by you in one tap."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <ListView
            android:id="@+id/eventsList"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add event page"
            android:backgroundTint="@color/teal"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
