<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/teal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Scan every"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/intervalSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notify me about new stories"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/notifySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Scan now"
            android:backgroundTint="@color/teal"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:id="@+id/batteryWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery optimization is on — background scans may be delayed or skipped while the app is closed."
                android:textSize="13sp"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/btnBatterySettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allow background activity"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/teal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Sources"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/teal_dark" />

        <LinearLayout
            android:id="@+id/sourceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add RSS / Atom feed"
            android:backgroundTint="@color/teal"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRethink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="↻ Rethink categories"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/teal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Re-analyze every story with the latest rules — run it after adding new feeds so the filters rebuild around them."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Backup &amp; restore"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/teal_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Save your feeds and event pages to a CSV file, and bring them back on this or another phone."
            android:textSize="13sp"
            android:textColor="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnExportConfig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Export"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/teal" />

            <Button
                android:id="@+id/btnImportConfig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="Import"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/teal" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
